# Copy this file to .env.local and fill in your own project's values.
# Never commit .env.local -- it's already in .gitignore.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Set to "1" only for local Playwright runs -- swaps the real iNaturalist
# call for a fixed, deterministic species (see lib/inaturalist.ts). Never set
# this in a real deploy.
BIRDSPOT_MOCK_AI=

# Only needed to let the Playwright suite clean up its own throwaway test
# users (and their uploaded photos) after a run -- a Supabase personal
# access token, the project ref, and the project's service_role key. Local
# test-cleanup use only. NEVER commit these, never paste service_role into
# a chat -- it belongs only here or in Supabase Edge Function secrets.
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
