# Copy this file to .env.local and fill in your own project's values.
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google Gemini API key, used server-side only (app/api/receipts/[id]/parse)
# to read receipt images. Never exposed to the browser. Same key/billing
# pattern as app/ (DL Trainer).
GEMINI_API_KEY=...

# Must match the hardcoded email in supabase/schema.sql's is_admin()
# function — used by the app to decide whether to show admin views.
ADMIN_EMAIL=daniel83larsson@gmail.com
