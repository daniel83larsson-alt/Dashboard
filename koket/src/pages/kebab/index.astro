---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { genereraBreadcrumbJsonLd, genereraItemListJsonLd } from '../../lib/recipe-schema';

const alla = await getCollection('ratter');
const kebab = alla.filter((r) => r.data.typ === 'kebab').sort((a, b) => a.data.ordning - b.data.ordning);
const kokList = await getCollection('kok');
const kokById = new Map(kokList.map((k) => [k.id, k]));

const jsonLd = [
  genereraBreadcrumbJsonLd([{ namn: 'Hem', url: '/' }, { namn: 'Kebab', url: '/kebab/' }]),
  genereraItemListJsonLd(
    'Kebab',
    kebab.map((r) => ({ namn: r.data.titel, url: `/${r.data.land.id}/${r.id.split('--').slice(1).join('--')}/` })),
  ),
];
---
<Base
  title="Kebab — tio spett från tio kök | Kökets nycklar"
  description="Nästan varje kök har sin egen variant av kebab. Tio varianter från tio länder — nyckelingredienser, metod, en fallgrop, samma format som resten av sajten."
  canonical="/kebab/"
  jsonLd={jsonLd}
>
  <nav class="breadcrumbs" aria-label="Brödsmulor">
    <a href="/">Hem</a><span class="sep">/</span><span aria-current="page">Kebab</span>
  </nav>

  <section class="breadsection">
    <div class="breadsection-inner">
      <h1 style="font-family:'Archivo Black',Impact,sans-serif;font-size:clamp(2rem,6.5vw,3.4rem);text-transform:uppercase;letter-spacing:-.015em;line-height:.95;margin-bottom:1rem">Kebab</h1>
      <p class="lead">Nästan varje kök har sin egen variant av kebab — antingen på spett över eld, eller tunt skivat kött staplat och roterat på en stående grill. Tio varianter från tio länder. Varje recept lever på sitt lands egen sida — länkarna nedan tar dig dit.</p>
      <div class="bread-grid">
        {kebab.map((r) => {
          const kok = kokById.get(r.data.land.id);
          const slug = r.id.split('--').slice(1).join('--');
          return (
            <a class="dish bread-card" href={`/${r.data.land.id}/${slug}/`} style="color:inherit;text-decoration:none;display:block">
              <div class="dish-head"><h3>{r.data.titel}</h3><span class="mins">{r.data.tidText}</span></div>
              <p class="flag" style="margin:.3rem 0 0">{kok?.data.land}</p>
              <figure class="dish-shot">
                <img src={r.data.bild.fil} width="1600" height="1000" loading="lazy" alt={r.data.bild.alt} />
              </figure>
              <p class="dish-teaser">{r.data.teaser}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
