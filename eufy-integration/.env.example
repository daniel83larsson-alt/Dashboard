# Kopiera denna fil till ".env" (samma mapp) och fyll i dina egna uppgifter.
# ".env" är redan gitignorad separat nedan - lägg ALDRIG riktiga uppgifter i .env.example
# och committa ALDRIG en riktig .env-fil till git.

EUFY_USERNAME=din-eufy-epost@example.com
EUFY_PASSWORD=ditt-eufy-losenord
EUFY_COUNTRY=SE
